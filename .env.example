NODE_ENV=development
APP_NAME=genericquick-ncr
APP_VERSION=0.1.0
LOG_LEVEL=debug
LOG_PRETTY=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genericquick?schema=public
DATABASE_POOL_SIZE=20
DATABASE_SSL=false
DATABASE_MIGRATION_TABLE=_prisma_migrations

REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=100

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key
MEILISEARCH_INDEX_PREFIX=gq_

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRESCRIPTIONS=gq-prescriptions
S3_BUCKET_CERTIFICATES=gq-certificates
S3_BUCKET_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

JWT_SECRET=CHANGE_ME_32_BYTES_MINIMUM_LENGTH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=genericquick-ncr
JWT_AUDIENCE=genericquick-ncr-api
SESSION_SECRET=CHANGE_ME_32_BYTES_MINIMUM_LENGTH
SESSION_COOKIE_NAME=gq_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

OCR_PROVIDER=not-configured
GOOGLE_VISION_API_KEY=
AWS_TEXTRACT_REGION=ap-south-1
AWS_TEXTRACT_ACCESS_KEY=
AWS_TEXTRACT_SECRET_KEY=
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=

PAYMENT_PROVIDER=not-configured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPI_COLLECT_MERCHANT_ID=

SMS_PROVIDER=not-configured
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
EMAIL_PROVIDER=not-configured
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
WHATSAPP_PROVIDER=not-configured

MAPS_PROVIDER=not-configured
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
GEOCODING_PROVIDER=not-configured

TELEMEDICINE_PROVIDER=not-configured
TELEMEDICINE_API_KEY=
TELEMEDICINE_WEBHOOK_SECRET=

CDSCO_API_URL=https://api.cdsco.gov.in
CDSCO_API_KEY=
PHARMACY_COUNCIL_DELHI_API=
PHARMACY_COUNCIL_HARYANA_API=
PHARMACY_COUNCIL_UP_API=

FEATURE_PRESCRIPTION_OCR=true
FEATURE_TELEMEDICINE=false
FEATURE_COLD_CHAIN=true
FEATURE_SCHEDULE_X=true
FEATURE_NTI_BLOCK=true
FEATURE_DEMAND_FORECASTING=false

DEFAULT_DELIVERY_RADIUS_KM=5
DEFAULT_MIN_SHELF_LIFE_DAYS=180
DEFAULT_PICKING_SLA_MINUTES=2
DEFAULT_PHARMACIST_REVIEW_SLA_SECONDS=60
DEFAULT_ORDER_EXPIRY_MINUTES=15
DEFAULT_RESERVATION_EXPIRY_MINUTES=30
MAX_CART_ITEMS=50
MAX_ORDER_ITEMS=100