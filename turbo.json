{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**", ".next/**"] },
    "lint": {},
    "test": { "outputs": ["coverage/**"], "dependsOn": [] },
    "test:ci": { "dependsOn": [] },
    "db:generate": {},
    "db:migrate": {},
    "db:seed": {},
    "db:studio": {},
    "dev": { "cache": false, "persistent": true }
  },
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL"]
}